{% extends "layouts.master" %}
{% block content %}
    {% if theme.settings.get('athar_auto_home', true) %}
        {% include 'components.athar.storefront' %}
    {% else %}
        {% component home %}
    {% endif %}
{% endblock %}
{% block scripts %}
    <script defer src="{{ 'home.js' | asset }}"></script>
{% endblock %}
