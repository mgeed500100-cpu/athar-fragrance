{# Zero-setup composition; each included section is separately registered in twilight.json. #}
<div class="athar-storefront">
    {% include 'components.home.athar-hero' with {component:{},componentId:'athar-auto-hero'} %}
    {% if theme.settings.get('athar_show_benefits', true) %}{% include 'components.home.athar-benefits' with {component:{}} %}{% endif %}
    {% if theme.settings.get('athar_show_products', true) %}{% include 'components.home.athar-products' with {component:{},componentId:'athar-products'} %}{% endif %}
    {% if theme.settings.get('athar_show_bento', true) %}{% include 'components.home.athar-bento' with {component:{},componentId:'athar-scents'} %}{% endif %}
    {% if theme.settings.get('athar_show_campaign', true) %}{% include 'components.home.athar-campaign' with {component:{},componentId:'athar-campaign'} %}{% endif %}
    {% if theme.settings.get('athar_show_journey', true) %}{% include 'components.home.athar-signature' with {component:{},componentId:'athar-journey'} %}{% endif %}
    {% if theme.settings.get('athar_show_new_products', true) %}{% include 'components.home.athar-products' with {component:{latest:true},componentId:'athar-new'} %}{% endif %}
    {% if theme.settings.get('athar_show_gifts', true) %}{% include 'components.home.athar-gifts' with {component:{},componentId:'athar-gifts'} %}{% endif %}
    {% if theme.settings.get('athar_show_product_story', true) %}{% include 'components.home.athar-product-story' with {component:{},componentId:'athar-product-story'} %}{% endif %}
    {% if theme.settings.get('athar_show_editorial', true) %}{% include 'components.home.athar-editorial' with {component:{},componentId:'athar-editorial'} %}{% endif %}
    {% if theme.settings.get('athar_show_social', true) %}{% include 'components.home.athar-social' with {component:{}} %}{% endif %}
    {% include 'components.home.athar-newsletter' with {component:{}} %}
</div>
